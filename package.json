{
  "name": "claude-prompt-reader",
  "displayName": "Claude Prompt Reader",
  "description": "Reads local prompt files and sends them to Claude",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-prompt-reader.readPrompts",
        "title": "Claude: Read Prompts"
      }
    ],
    "configuration": {
      "title": "Claude Prompt Reader",
      "properties": {
        "claudePromptReader.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Anthropic API key"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.5",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "sinon": "^21.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0"
  }
}
